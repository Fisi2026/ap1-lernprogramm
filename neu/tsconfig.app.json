{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* N32: ausdruecklich - TS 6 setzt strict nur als Vorgabe; eine Vorgabe kann die naechste
       Fassung aendern, eine Zeile hier nicht. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Pfad-Alias fuer shadcn/ui */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  /* Testcode braucht Node-Typen, App-Code nicht. Die Grenze steht im
     Typsystem statt in der Selbstdisziplin - siehe tsconfig.test.json. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/pruefstand.ts", "src/testhilfe/*.ts"]
}
