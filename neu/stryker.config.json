{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "mutate": ["src/kern/**/*.ts", "src/server/**/*.ts", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/server/fragen-ids.ts", "!src/kern/tabellen/**"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "inPlace": true,
  "incremental": true,
  "incrementalFile": "../_to_delete/helfer/stryker/incremental.json",
  "concurrency": 6,
  "dryRunTimeoutMinutes": 20,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "../_to_delete/helfer/stryker/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 88 }
}
