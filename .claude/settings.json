{
  "permissions": { "allow": [
    "Bash(bash tools/postfach.sh:*)",
    "Bash(gh pr comment 1 --repo Fisi2026/ap1-postfach:*)",
    "Bash(gh pr comment 2 --repo Fisi2026/ap1-postfach:*)",
    "Bash(bash tools/gitc.sh push origin main)"
  ] },
  "env": { "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1" },
  "hooks": {
    "SessionStart": [ { "hooks": [ { "type": "command",
      "command": "bash \"$CLAUDE_PROJECT_DIR/tools/postfach.sh\" start", "timeout": 30 } ] } ],
    "PreToolUse": [ { "matcher": "Bash|PowerShell|mcp__Training_Shell__run", "hooks": [ { "type": "command",
      "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/git_riegel.js\"", "timeout": 10 } ] } ]
  }
}
